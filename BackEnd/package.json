{
  "name": "app-fin-backend",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "start:dev": "tsc-watch --noClear -p tsconfig.json --onSuccess \"node dist/src/app.js\"",
    "build": "tsc",
    "test": "bash test/run-integration.sh",
    "start": "node dist/src/app.js",
    "migration:create": "node dist/src/shared/db/crear-migracion.js",
    "migration:up": "node -e \"import('./dist/src/shared/db/orm.js').then(async m=>{await m.migrar();await m.orm.close()})\""
  },
  "dependencies": {
    "@mikro-orm/core": "^6.6.2",
    "@mikro-orm/migrations": "^6.6.2",
    "@mikro-orm/mysql": "^6.6.2",
    "@mikro-orm/sql-highlighter": "^1.0.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.16.0",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.0.0",
    "tsc-watch": "^7.2.0",
    "typescript": "^5.9.3"
  }
}
